# Backend API
NEXT_PUBLIC_API_URL=http://localhost:5122

# Public site URL (sitemap, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key: browser client (safe to expose, RLS applies)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key: server-only reads (bypasses RLS, never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=sb_secret_xxx
